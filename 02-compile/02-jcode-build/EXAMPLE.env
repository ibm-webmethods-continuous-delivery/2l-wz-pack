# Copy this file to .env and adjust for your environment.
#
# WZP_WM_HOME differs by MSR version:
#   10.x / 11.x  ->  /opt/softwareag
#   12.x         ->  /opt/webmethods
#
# WZP_LOCAL_UID / WZP_LOCAL_GID: run `id -u` and `id -g` to get your values.
# Files written into the mounted IS packages tree will be owned by this user/group.
#
# --- 10.x ---
# WZP_MSR_IMAGE=ibmwebmethods.azurecr.io/webmethods-microservicesruntime:10.11.0.2-ubi
# WZP_WM_HOME=/opt/softwareag
# WZP_GUEST_IS_HOME=/opt/softwareag/IntegrationServer
#
# --- 11.x ---
WZP_MSR_IMAGE=ibmwebmethods.azurecr.io/webmethods-microservicesruntime:11.1.0.12
WZP_WM_HOME=/opt/softwareag
WZP_GUEST_IS_HOME=/opt/softwareag/IntegrationServer
#
# --- 12.x ---
# WZP_MSR_IMAGE=ibmwebmethods.azurecr.io/webmethods-microservicesruntime:12.1.0.2
# WZP_WM_HOME=/opt/webmethods
# WZP_GUEST_IS_HOME=/opt/webmethods/IntegrationServer

WZP_GUEST_PACKAGES_FOLDER=${WZP_GUEST_IS_HOME}/packages

# Local user identity – defaults to 1001 if not set
WZP_LOCAL_UID=1001
WZP_LOCAL_GID=1001
